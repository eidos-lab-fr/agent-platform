# Agent HQ needs no configuration on your machine: it signs in with the GitHub CLI
# (`gh auth login -s repo,workflow`). Copy this file to .env.local only to change a default.
# `npm run setup` checks everything and creates .env.local for you.

# Organization whose repos Agent HQ follows
GITHUB_ORG=eidos-lab-fr

# Optional: fixed list of repos to follow (otherwise: the org's repos that have .github/workflows/agent-dev.yml)
HQ_REPOS=

# Optional: a token instead of the GitHub CLI one (scopes repo and workflow)
GITHUB_TOKEN=

# AI that writes the specs: easier from the page AI settings (saved in .hq/ai.json).
# With the claude command installed and signed in, your Claude subscription is used, no key needed.
# Never used by the agents themselves, whose key stays in GitHub secrets.
# AI_PROVIDER=auto          (auto, claude-code, anthropic, openai, deepseek, ollama or rules)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Hosting Agent HQ for others (not needed on your machine): a GitHub OAuth App.
# Callback URL: <APP_URL>/api/auth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APP_URL=https://hq.example.com
# SESSION_SECRET=            (32 characters or more; `npm run setup` generates one)
# ALLOWED_LOGINS=            (GitHub logins allowed to sign in, comma-separated)

# Other overrides, rarely needed:
# HQ_AUTH=auto              (auto, local, oauth or demo)
# PLATFORM_REPO=agent-platform
# HQ_DATA_BRANCH=hq-data    (branch of the platform repo where teams are saved)
# OLLAMA_URL=http://127.0.0.1:11434
# Models: CLAUDE_CODE_MODEL, ANTHROPIC_MODEL, OPENAI_MODEL, DEEPSEEK_MODEL, OLLAMA_MODEL

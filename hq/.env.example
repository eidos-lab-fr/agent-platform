# Application OAuth GitHub (Settings > Developer settings > OAuth Apps)
# URL de callback : <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL publique de l'application, sans slash final
APP_URL=http://localhost:3000

# Clé de chiffrement du cookie de session : 32 caractères ou plus
SESSION_SECRET=

# Logins GitHub autorisés à se connecter, séparés par des virgules.
# Doit correspondre à allowed_users des workflows d'agent-platform.
ALLOWED_LOGINS=AdrienBalcioglu

# Organisation et repo de la plateforme
GITHUB_ORG=eidos-lab-fr
PLATFORM_REPO=agent-platform

# Facultatif : liste fixe de repos à suivre (sinon : repos de l'org qui ont .github/workflows/agent-dev.yml)
HQ_REPOS=

# Sans GITHUB_CLIENT_ID, l'application tourne en mode démo (monde simulé).

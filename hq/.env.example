# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback URL: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of the app, without a trailing slash
APP_URL=http://localhost:3000

# Session cookie encryption key: 32 characters or more
SESSION_SECRET=

# GitHub logins allowed to sign in, comma-separated.
# Must match allowed_users in the agent-platform workflows.
ALLOWED_LOGINS=AdrienBalcioglu

# Organization and platform repo
GITHUB_ORG=eidos-lab-fr
PLATFORM_REPO=agent-platform

# Optional: fixed list of repos to follow (otherwise: org repos that have .github/workflows/agent-dev.yml)
HQ_REPOS=

# Writing requests from a prompt ("Describe it").
# auto: a local model through Ollama if it answers, else Claude if ANTHROPIC_API_KEY is set, else simple rules.
SPEC_ENGINE=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Optional: only used to rewrite requests, never by the agents themselves
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Without GITHUB_CLIENT_ID, the app runs in demo mode (simulated world).
